@echo off\nREM Pulsar RAT v2.4.5 - Direct Execution Test (No I/O Redirection)\nREM Tests the deployed binaries to verify encryption handshake fix\n\necho.\necho =========================================\necho PULSAR RAT v2.4.5 - DIRECT LAUNCH TEST\necho =========================================\necho.\n\ncd /d \"C:\\Users\\chris\\Desktop\\Workspace\\PulsarRAT_Deploy\"\n\necho [Step 1] Kill any existing processes\ntaskkill /F /IM Pulsar.exe 2>nul\ntaskkill /F /IM Client.exe 2>nul\ntimeout /t 2 /nobreak >nul\n\necho [Step 2] Launch Server\necho.\necho Starting: Pulsar.exe\nstart \"\" Pulsar.exe\ntimeout /t 4 /nobreak >nul\n\necho.\necho Checking server...\ntasklist | find /i \"Pulsar\"\nif errorlevel 1 (\n    echo ERROR: Server failed to start\n    echo.\n    echo Attempting direct execution for error details:\n    Pulsar.exe\n    pause\n    exit /b 1\n)\n\necho OK - Server running\n\necho.\necho [Step 3] Launch Client\necho.\necho Starting: Client.exe\nstart \"\" Client.exe\ntimeout /t 3 /nobreak >nul\n\necho.\necho Checking client...\ntasklist | find /i \"Client\"\nif errorlevel 1 (\n    echo ERROR: Client failed to start\n    echo.\n    echo Attempting direct execution for error details:\n    Client.exe\n    pause\n    exit /b 1\n)\n\necho OK - Client running\n\necho.\necho =========================================\necho [Step 4] MONITORING - 30 SECONDS\necho =========================================\necho.\n\nset counter=0\n:monitor_loop\n\ntasklist | find /i \"Pulsar\" >nul\nif errorlevel 1 (\n    echo.\n    echo FAIL: Server crashed at %counter% seconds\n    pause\n    exit /b 1\n)\n\ntasklist | find /i \"Client\" >nul\nif errorlevel 1 (\n    echo.\n    echo FAIL: Client crashed at %counter% seconds\n    pause\n    exit /b 1\n)\n\necho [%counter%s] Both processes stable\ntimeout /t 1 /nobreak >nul\n\nset /a counter=%counter%+1\nif %counter% leq 30 goto monitor_loop\n\necho.\necho =========================================\necho SUCCESS - TEST PASSED\necho =========================================\necho.\necho Both processes ran successfully for 30 seconds\necho Encryption handshake working - deployment ready\necho.\npause\n