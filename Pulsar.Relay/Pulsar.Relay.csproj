<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Pulsar.Relay</AssemblyName>
    <RootNamespace>Pulsar.Relay</RootNamespace>
    <Description>Dependency-free CLI TCP relay for Pulsar: accepts client connections and forwards (proxies) them to upstream Pulsar servers.</Description>
  </PropertyGroup>

</Project>
