<Window x:Class="Pulsar.Server.Dialogs.MessageBoxInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Send Message Box"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}"
        FontFamily="Segoe UI"
        FontSize="12"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Pulsar;component/Resources/Styles/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Padding="20"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="💬" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="Send Message Box" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="TargetClientTextBlock"
                       Text="Target: —"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,14" />

            <TextBlock Text="Caption" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox x:Name="CaptionTextBox"
                     MaxLength="4096"
                     Margin="0,0,0,10"
                     Text="Notification" />

            <TextBlock Text="Message Text (required)" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox x:Name="MessageTextBox"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="92"
                     VerticalContentAlignment="Top"
                     Margin="0,0,0,12"
                     TextChanged="MessageTextBox_TextChanged" />

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Buttons" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ComboBox x:Name="ButtonComboBox" SelectedIndex="0" Padding="6,4">
                        <ComboBoxItem Content="OK" />
                        <ComboBoxItem Content="OKCancel" />
                        <ComboBoxItem Content="YesNo" />
                        <ComboBoxItem Content="YesNoCancel" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Icon" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ComboBox x:Name="IconComboBox" SelectedIndex="0" Padding="6,4">
                        <ComboBoxItem Content="Information" />
                        <ComboBoxItem Content="Warning" />
                        <ComboBoxItem Content="Error" />
                        <ComboBoxItem Content="Question" />
                        <ComboBoxItem Content="None" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        IsCancel="True"
                        MinWidth="92"
                        Margin="0,0,8,0"
                        Style="{StaticResource SecondaryCompactButtonStyle}"
                        Click="CancelButton_Click" />
                <Button x:Name="SendButton"
                        Content="Send Message"
                        IsDefault="True"
                        IsEnabled="False"
                        MinWidth="120"
                        Margin="0"
                        Style="{StaticResource SystemControlActionButtonStyle}"
                        Click="SendButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
