<Window x:Class="Pulsar.Server.Dialogs.QuickCommandInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Execute Quick Command"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}"
        FontFamily="Segoe UI"
        FontSize="12"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Pulsar;component/Resources/Styles/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Padding="20"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource SystemControlGlassBorder}"
            BorderThickness="1">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="⚡" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="Execute Quick Command" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="TargetClientTextBlock"
                       Text="Target: —"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,14" />

            <TextBlock Text="Command Host" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox x:Name="HostComboBox"
                      IsEditable="True"
                      SelectedIndex="0"
                      Padding="6,4"
                      Margin="0,0,0,10">
                <ComboBoxItem Content="cmd.exe" />
                <ComboBoxItem Content="powershell.exe" />
            </ComboBox>

            <TextBlock Text="Command (required)" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox x:Name="CommandTextBox"
                     FontFamily="Consolas"
                     FontSize="12"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="96"
                     VerticalContentAlignment="Top"
                     Margin="0,0,0,16"
                     TextChanged="CommandTextBox_TextChanged" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        IsCancel="True"
                        MinWidth="92"
                        Margin="0,0,8,0"
                        Style="{StaticResource SecondaryCompactButtonStyle}"
                        Click="CancelButton_Click" />
                <Button x:Name="ExecuteButton"
                        Content="Execute Command"
                        IsDefault="True"
                        IsEnabled="False"
                        MinWidth="136"
                        Margin="0"
                        Style="{StaticResource SystemControlActionButtonStyle}"
                        Click="ExecuteButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
