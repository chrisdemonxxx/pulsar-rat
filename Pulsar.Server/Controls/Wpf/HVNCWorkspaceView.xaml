<UserControl x:Class="Pulsar.Server.Controls.Wpf.HVNCWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <Grid Background="#101318">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#171B21" BorderBrush="#2A3038" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#58D68D" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding SessionState}" Foreground="#F4F6F8" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="  /  " Foreground="#707780"/>
                    <TextBlock Text="{Binding StreamState}" Foreground="#AAB2BC" FontSize="12"/>
                </StackPanel>
                <ComboBox Grid.Column="1" Width="150" Height="30" Margin="8,0"
                          ItemsSource="{Binding Monitors}"
                          SelectedItem="{Binding SelectedMonitor}"
                          VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Quality" Foreground="#AAB2BC" VerticalAlignment="Center" Margin="8,0"/>
                    <Slider Width="140" Minimum="25" Maximum="100"
                            Value="{Binding Quality}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Width="188"
                Background="#14181E" BorderBrush="#2A3038" BorderThickness="0,0,1,0"
                Visibility="{Binding CommandRailVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Margin="10">
                <TextBlock Text="DESKTOP" Foreground="#707780" FontSize="10" FontWeight="Bold" Margin="6,8"/>
                <Button Content="Remote View" Height="38" Margin="0,2"/>
                <TextBlock Text="BROWSERS" Foreground="#707780" FontSize="10" FontWeight="Bold" Margin="6,14,6,8"/>
                <Button Content="Browser Catalog" Height="38" Margin="0,2"/>
                <TextBlock Text="SHELL" Foreground="#707780" FontSize="10" FontWeight="Bold" Margin="6,14,6,8"/>
                <Button Content="PowerShell" Height="38" Margin="0,2"/>
                <Button Content="Command Prompt" Height="38" Margin="0,2"/>
                <TextBlock Text="TOOLS" Foreground="#707780" FontSize="10" FontWeight="Bold" Margin="6,14,6,8"/>
                <Button Content="Custom Application" Height="38" Margin="0,2"/>
                <Button Content="Explorer" Height="38" Margin="0,2"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Background="#080A0D">
            <Grid>
                <Border Margin="20" CornerRadius="8" Background="#050607" BorderBrush="#242A31" BorderThickness="1">
                    <TextBlock Text="Remote Viewport"
                               Foreground="#5F6873"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="14"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Width="260"
                Background="#14181E" BorderBrush="#2A3038" BorderThickness="1,0,0,0"
                Visibility="{Binding InspectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Margin="14">
                <TextBlock Text="SESSION INSPECTOR" Foreground="#707780" FontSize="10" FontWeight="Bold"/>
                <TextBlock Text="{Binding StreamState}" Foreground="#F4F6F8" FontSize="15" Margin="0,12,0,4"/>
                <TextBlock Text="{Binding LaunchState}" Foreground="#AAB2BC" Margin="0,4"/>
                <Separator Margin="0,12"/>
                <TextBlock Text="FRAME HEALTH" Foreground="#707780" FontSize="10" FontWeight="Bold"/>
                <TextBlock Margin="0,10,0,0" Foreground="#AAB2BC">
                    <Run Text="Capture FPS "/><Run Text="{Binding CaptureFps, StringFormat={}{0:0.0}}" Foreground="#F4F6F8"/>
                </TextBlock>
                <TextBlock Margin="0,6,0,0" Foreground="#AAB2BC">
                    <Run Text="Render FPS "/><Run Text="{Binding RenderFps, StringFormat={}{0:0.0}}" Foreground="#F4F6F8"/>
                </TextBlock>
                <TextBlock Margin="0,6,0,0" Foreground="#AAB2BC">
                    <Run Text="Queue "/><Run Text="{Binding Backlog}" Foreground="#F4F6F8"/>
                    <Run Text=" / "/><Run Text="{Binding MaximumBacklog}" Foreground="#F4F6F8"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#171B21" BorderBrush="#2A3038" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <TextBlock Text="{Binding SessionState}" Foreground="#AAB2BC" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding LaunchState}" Foreground="#AAB2BC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
