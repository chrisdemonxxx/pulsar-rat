<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Styled Tooltip for Rich Action Hints -->
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{DynamicResource ToolTipBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToolTipBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Red Glass Morphism Card (System Control) -->
    <Style x:Key="SystemControlGlassCardStyle" TargetType="{x:Type ContentControl}">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Grid>
                        <!-- Sibling drop shadow keeps all text crisp -->
                        <Border CornerRadius="10"
                                Background="#20000000">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16"
                                                  ShadowDepth="3"
                                                  Direction="270"
                                                  Opacity="0.32"
                                                  Color="#991B1B" />
                            </Border.Effect>
                        </Border>

                        <!-- Translucent crimson frosted glass body -->
                        <Border Background="{DynamicResource SystemControlGlassBackground}"
                                BorderBrush="{DynamicResource SystemControlGlassBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                ClipToBounds="True">
                            <Grid>
                                <!-- Top frosted specular highlight edge -->
                                <Border Height="1.5"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource SystemControlGlassHighlight}"
                                        IsHitTestVisible="False" />
                                <ContentPresenter Margin="12" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Blue Glass Morphism Card (Tool Launch) -->
    <Style x:Key="ToolLaunchGlassCardStyle" TargetType="{x:Type ContentControl}">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Grid>
                        <Border CornerRadius="10"
                                Background="#1A000000">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14"
                                                  ShadowDepth="2"
                                                  Direction="270"
                                                  Opacity="0.26"
                                                  Color="#1D4ED8" />
                            </Border.Effect>
                        </Border>

                        <Border Background="{DynamicResource ToolLaunchGlassBackground}"
                                BorderBrush="{DynamicResource ToolLaunchGlassBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                ClipToBounds="True">
                            <Grid>
                                <Border Height="1.5"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource ToolLaunchGlassHighlight}"
                                        IsHitTestVisible="False" />
                                <ContentPresenter Margin="12" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Neutral Elevated Glass Card (Client Info / Debug Log) -->
    <Style x:Key="InfoGlassCardStyle" TargetType="{x:Type ContentControl}">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Grid>
                        <Border CornerRadius="10"
                                Background="#14000000">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12"
                                                  ShadowDepth="2"
                                                  Direction="270"
                                                  Opacity="0.22"
                                                  Color="#000000" />
                            </Border.Effect>
                        </Border>

                        <Border Background="{DynamicResource InfoCardGlassBackground}"
                                BorderBrush="{DynamicResource InfoCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                ClipToBounds="True">
                            <ContentPresenter Margin="12" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Info Cell Container -->
    <Style x:Key="InfoMetricCellStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource InfoCellBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="3" />
    </Style>

</ResourceDictionary>
